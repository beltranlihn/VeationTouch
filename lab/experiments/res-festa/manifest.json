{
  "id": "res-festa",
  "name": "Ressonància study — Resonance",
  "description": "Study of the free, interactive part of L'aleta: the four walls become one surface that resonates; every hand sends a wave of gold round the room.",
  "entry": "index.html",
  "params": [
    { "key": "progress", "label": "Study: progress", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0 },
    { "key": "brightness", "label": "Brightness", "type": "number", "min": 0.3, "max": 2, "step": 0.05, "default": 1 },
    { "key": "bloom", "label": "Bloom", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    { "key": "quality", "label": "Quality", "type": "select", "default": "high", "options": [["low", "Low"], ["medium", "Medium"], ["high", "High"]] },
    { "key": "auto", "label": "Study: plays alone with < 2 hands", "type": "bool", "default": true },
    { "key": "sensitivity", "label": "Resonance gain", "type": "number", "min": 0, "max": 3, "step": 0.05, "default": 1 },
    { "key": "speed", "label": "Wave speed", "type": "number", "min": 1.5, "max": 9, "step": 0.1, "default": 4.5, "unit": "m/s" },
    { "key": "ring", "label": "Ring time", "type": "number", "min": 0.5, "max": 8, "step": 0.1, "default": 3, "unit": "s" },
    { "key": "lines", "label": "Line density", "type": "number", "min": 0.3, "max": 3, "step": 0.05, "default": 1 },
    { "key": "glow", "label": "Line brightness", "type": "number", "min": 0, "max": 3, "step": 0.05, "default": 1 },
    { "key": "still", "label": "Stillness of the figures", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.7 },
    { "key": "clip", "label": "Energy limit", "type": "number", "min": 0.1, "max": 2, "step": 0.05, "default": 0.6 },
    { "key": "sparks", "label": "Sparks", "type": "number", "min": 0, "max": 3, "step": 0.05, "default": 1 }
  ]
}

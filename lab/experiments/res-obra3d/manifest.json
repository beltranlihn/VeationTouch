{
  "id": "res-obra3d",
  "name": "Ressonància — the whole work in 3D",
  "description": "The whole 10-minute work in 3D: the score walks the pass from the wait to the acta; each block shows its universe (a night square, a castell of light, fire, bodies, night, resonance), arriving and leaving as fragments, with hand targets and words on the walls that guide the public.",
  "entry": "index.html",
  "params": [
    {"key": "jump", "label": "Go to", "type": "select", "default": "none", "options": [["none", "—"], ["wait", "Wait"], ["intro", "Intro: La plaça"], ["brasa", "I. Brasa"], ["pinya", "II. Pinya"], ["tronc", "III. Tronc"], ["pom", "IV. Pom de dalt"], ["crown", "V. L'aleta: the crown"], ["festa", "V. La ressonància"], ["baixada", "La baixada"], ["fall", "The fall"], ["acta", "L'acta"]]},
    {"key": "pace", "label": "Pace", "type": "number", "min": 0.5, "max": 8, "step": 0.25, "default": 1},
    {"key": "guide", "label": "Guide (targets and text)", "type": "bool", "default": true},
    {"key": "bloom", "label": "Bloom", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 0.6},
    {"key": "exposure", "label": "Exposure", "type": "number", "min": 0.2, "max": 3, "step": 0.05, "default": 1},
    {"key": "quality", "label": "Quality", "type": "select", "default": "high", "options": [["low", "Low (laptop: 60 % resolution, fewer particles)"], ["medium", "Medium (80 %)"], ["high", "High (the room: 100 %, antialiased)"]]},
    {"key": "renderer", "label": "Renderer", "type": "select", "default": "auto", "options": [["auto", "Automatic (WebGPU when available)"], ["webgl2", "WebGL2"]]},
    {"key": "mode", "label": "Mode (room ignores lab URL switches; reload)", "type": "select", "default": "auto", "options": [["auto", "Auto (room inside the app)"], ["room", "Room"], ["lab", "Lab (URL switches ?q3 ?tiles ?eye ?aa ?parts)"]]},
    {"key": "tuning", "label": "Thresholds preset", "type": "select", "default": "lab", "options": [["lab", "Lab (the score as it is)"], ["sala", "Room (tolerant start for the real sensor)"]]},
    {"key": "t.linger", "label": "Hold: wall stays held after a hand (s)", "type": "number", "min": 0.5, "max": 6, "step": 0.25, "default": 2, "unit": "s"},
    {"key": "t.abandon", "label": "Empty room → back to wait (s; warn at half)", "type": "number", "min": 20, "max": 180, "step": 5, "default": 45, "unit": "s"},
    {"key": "t.start", "label": "Wait: hold on the start button (s)", "type": "number", "min": 1, "max": 8, "step": 0.5, "default": 3, "unit": "s"},
    {"key": "t.reveal.button", "label": "Wait: start button half-width (m)", "type": "number", "min": 0.3, "max": 1.2, "step": 0.05, "default": 0.55, "unit": "m"},
    {"key": "t.title", "label": "Chapter card on screen (s)", "type": "number", "min": 2, "max": 10, "step": 0.5, "default": 6, "unit": "s"},
    {"key": "t.dup", "label": "Same hand if a new id is within (m)", "type": "number", "min": 0.04, "max": 0.3, "step": 0.01, "default": 0.1, "unit": "m"},
    {"key": "t.hand.size", "label": "Hand width when the sensor gives none (m)", "type": "number", "min": 0.05, "max": 0.3, "step": 0.01, "default": 0.12, "unit": "m"},
    {"key": "t.hand.span", "label": "Pinya/span window width (m)", "type": "number", "min": 1, "max": 3.5, "step": 0.1, "default": 2, "unit": "m"},
    {"key": "t.hand.moved", "label": "Call: resting hand counts if it moved (m)", "type": "number", "min": 0.03, "max": 0.3, "step": 0.01, "default": 0.1, "unit": "m"},
    {"key": "t.hand.recent", "label": "Call: or if it landed less than (s) ago", "type": "number", "min": 0.5, "max": 5, "step": 0.25, "default": 2, "unit": "s"},
    {"key": "t.brasa.early", "label": "Brasa call: early window before TOK (s)", "type": "number", "min": 0.2, "max": 1.5, "step": 0.05, "default": 0.5, "unit": "s"},
    {"key": "t.brasa.late", "label": "Brasa call: late window after TOK (s)", "type": "number", "min": 0.2, "max": 2, "step": 0.05, "default": 0.7, "unit": "s"},
    {"key": "t.brasa.max", "label": "Brasa: longest (s)", "type": "number", "min": 45, "max": 120, "step": 5, "default": 75, "unit": "s"},
    {"key": "t.pinya.pack.0", "label": "Pinya: packed from (0–1)", "type": "number", "min": 0.2, "max": 0.9, "step": 0.05, "default": 0.55},
    {"key": "t.pinya.pack.1", "label": "Pinya: fully packed at (0–1)", "type": "number", "min": 0.4, "max": 1, "step": 0.05, "default": 0.9},
    {"key": "t.pinya.hold", "label": "Pinya: hold the circle (s)", "type": "number", "min": 1, "max": 8, "step": 0.5, "default": 3, "unit": "s"},
    {"key": "t.pinya.net", "label": "Pinya: the colla helps after (s)", "type": "number", "min": 15, "max": 90, "step": 5, "default": 40, "unit": "s"},
    {"key": "t.pinya.nearFull", "label": "Pinya: packed counts fully up to (m from centre)", "type": "number", "min": 0.8, "max": 3, "step": 0.1, "default": 1.8, "unit": "m"},
    {"key": "t.pinya.nearZero", "label": "Pinya: packed counts nothing from (m)", "type": "number", "min": 1.5, "max": 4, "step": 0.1, "default": 3, "unit": "m"},
    {"key": "t.tronc.rise", "label": "Tronc: a lift counts from (m)", "type": "number", "min": 0.1, "max": 0.6, "step": 0.01, "default": 0.33, "unit": "m"},
    {"key": "t.tronc.foot", "label": "Tronc wobble: hands below (m) steady it", "type": "number", "min": 0.5, "max": 1.6, "step": 0.05, "default": 0.95, "unit": "m"},
    {"key": "t.tronc.wobble", "label": "Tronc wobble: time to steady it (s)", "type": "number", "min": 2, "max": 12, "step": 0.5, "default": 5, "unit": "s"},
    {"key": "t.tronc.help", "label": "Tronc: walls without tower help (0–1)", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5},
    {"key": "t.tronc.gain", "label": "Tronc: climb speed", "type": "number", "min": 0.3, "max": 1.5, "step": 0.02, "default": 0.72},
    {"key": "t.tronc.base", "label": "Tronc: a hand that moved less (m) is the base", "type": "number", "min": 0.05, "max": 0.4, "step": 0.01, "default": 0.15, "unit": "m"},
    {"key": "t.pom.still", "label": "Pom: still = moved less than (m in 1 s)", "type": "number", "min": 0.05, "max": 0.4, "step": 0.01, "default": 0.15, "unit": "m"},
    {"key": "t.pom.empty", "label": "Pom: empty room falls after (s)", "type": "number", "min": 8, "max": 60, "step": 1, "default": 20, "unit": "s"},
    {"key": "t.pom.climb.0", "label": "Pom relay: length when held still (s)", "type": "number", "min": 20, "max": 60, "step": 1, "default": 38, "unit": "s"},
    {"key": "t.pom.relay.every", "label": "Pom relay: hop to the next still hand every (s)", "type": "number", "min": 2, "max": 8, "step": 0.5, "default": 4, "unit": "s"},
    {"key": "t.pom.relay.ready", "label": "Pom relay: a hand is ready after still (s)", "type": "number", "min": 0.3, "max": 3, "step": 0.1, "default": 1, "unit": "s"},
    {"key": "t.pom.relay.falter", "label": "Pom relay: holder moving → goes back after (s)", "type": "number", "min": 0.5, "max": 4, "step": 0.1, "default": 1.2, "unit": "s"},
    {"key": "t.pom.climb.1", "label": "Pom breath: length at full speed (s)", "type": "number", "min": 8, "max": 30, "step": 1, "default": 16, "unit": "s"},
    {"key": "t.pom.gust", "label": "Pom breath: a gust = moved more than (m in 1 s)", "type": "number", "min": 0.2, "max": 1, "step": 0.05, "default": 0.35, "unit": "m"},
    {"key": "t.pom.climb.2", "label": "Pom silence: length (s)", "type": "number", "min": 5, "max": 20, "step": 1, "default": 10, "unit": "s"},
    {"key": "t.pom.breakCost", "label": "Pom silence: a move costs (share of the climb)", "type": "number", "min": 0, "max": 0.2, "step": 0.01, "default": 0.06},
    {"key": "t.print.rest", "label": "Acta: a hand leaves a print after resting (s)", "type": "number", "min": 0.2, "max": 2, "step": 0.1, "default": 0.5, "unit": "s"},
    {"key": "t.aleta.rise", "label": "L'aleta: a raise counts from (m)", "type": "number", "min": 0.1, "max": 0.5, "step": 0.01, "default": 0.28, "unit": "m"},
    {"key": "t.aleta.high", "label": "L'aleta: or a hand above (m)", "type": "number", "min": 1.2, "max": 2.2, "step": 0.05, "default": 1.6, "unit": "m"},
    {"key": "t.aleta.quorum", "label": "L'aleta: share of hands to crown (0–1)", "type": "number", "min": 0.2, "max": 1, "step": 0.05, "default": 0.6},
    {"key": "t.aleta.window", "label": "L'aleta: crowns anyway after (s)", "type": "number", "min": 4, "max": 20, "step": 1, "default": 10, "unit": "s"},
    {"key": "t.festa.early", "label": "Festa call: early window (s)", "type": "number", "min": 0.2, "max": 1.5, "step": 0.05, "default": 0.5, "unit": "s"},
    {"key": "t.festa.late", "label": "Festa call: late window (s)", "type": "number", "min": 0.2, "max": 2, "step": 0.05, "default": 0.7, "unit": "s"},
    {"key": "t.festa.window", "label": "Festa echo: answer window ± (s)", "type": "number", "min": 0.3, "max": 2, "step": 0.05, "default": 0.7, "unit": "s"},
    {"key": "t.festa.travel", "label": "Festa echo: front crossing time (s)", "type": "number", "min": 1.5, "max": 6, "step": 0.25, "default": 3, "unit": "s"},
    {"key": "t.festa.ghost", "label": "Festa echo: room answers after (s)", "type": "number", "min": 4, "max": 30, "step": 1, "default": 12, "unit": "s"},
    {"key": "t.baixada.lower", "label": "Baixada: a descent counts from (m)", "type": "number", "min": 0.1, "max": 0.6, "step": 0.01, "default": 0.35, "unit": "m"},
    {"key": "t.baixada.gentle", "label": "Baixada: gentle up to (m/s), faster creaks", "type": "number", "min": 0.2, "max": 1, "step": 0.05, "default": 0.4, "unit": "m/s"},
    {"key": "t.baixada.empty", "label": "Baixada: let go → carregat after (s)", "type": "number", "min": 4, "max": 30, "step": 1, "default": 10, "unit": "s"},
    {"key": "t.baixada.outside", "label": "Baixada: walls without tower count (0–1)", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5}
  ]
}

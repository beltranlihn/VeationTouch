{
  "id": "lab-template",
  "name": "Lab template — Halo",
  "description": "A runtime-ready starting point: every hand leaves a soft light that slowly dissolves. One WebGL2 page, the whole strip, seamless round the room. Copy this folder and change it.",
  "entry": "index.html",
  "params": [
    { "key": "glow", "label": "Glow size", "type": "number", "min": 0.1, "max": 0.8, "step": 0.01, "default": 0.28, "unit": "m" },
    { "key": "fade", "label": "Fade", "type": "number", "min": 1, "max": 20, "step": 0.5, "default": 7, "unit": "s" },
    { "key": "brightness", "label": "Brightness", "type": "number", "min": 0.2, "max": 2, "step": 0.05, "default": 1 },
    { "key": "ambience", "label": "Ambience", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5 },
    { "key": "quality", "label": "Quality", "type": "select", "default": "medium", "options": [["low", "Low"], ["medium", "Medium"], ["high", "High"]] }
  ]
}

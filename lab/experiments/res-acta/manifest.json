    { "key": "outcome", "label": "Outcome", "type": "select", "default": "descarregat", "options": [["descarregat", "Descarregat"], ["carregat", "Carregat"], ["intent", "Intent"]] },
    { "key": "structure", "label": "Structure (people per floor)", "type": "number", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "key": "floors", "label": "Floors", "type": "number", "min": 1, "max": 9, "step": 1, "default": 7 },
    { "key": "forca", "label": "Força (strength)", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0.82 },
    { "key": "equilibri", "label": "Equilibri (balance)", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0.64 },
    { "key": "valor", "label": "Valor (courage)", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0.91 },
    { "key": "seny", "label": "Seny (good sense)", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0.73 },
    { "key": "hands", "label": "Hands (most at once)", "type": "number", "min": 1, "max": 32, "step": 1, "default": 14 },

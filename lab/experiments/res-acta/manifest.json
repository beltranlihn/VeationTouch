    { "key": "brightness", "label": "Brightness", "type": "number", "min": 0.3, "max": 2, "step": 0.05, "default": 1 },
    { "key": "bloom", "label": "Bloom", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    { "key": "dust", "label": "Dust", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    { "key": "handStir", "label": "Hand stirs the dust", "type": "number", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    { "key": "lineHeight", "label": "Horizon height", "type": "number", "min": 1.0, "max": 1.6, "step": 0.01, "default": 1.25, "unit": "m" },
    { "key": "quality", "label": "Quality", "type": "select", "default": "high", "options": [["low", "Low"], ["medium", "Medium"], ["high", "High"]] }
